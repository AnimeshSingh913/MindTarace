# MindTrace reads MINDTRACE_* environment variables. All are optional unless noted.
# Locally: set them in your shell. On Render/Vercel: set them in the dashboard.

# --- Model provider ---
# ollama (local, default) | openai (any OpenAI-compatible API: Groq, OpenRouter, Together, OpenAI...)
MINDTRACE_PROVIDER=ollama

# Ollama (provider=ollama)
MINDTRACE_OLLAMA_URL=http://127.0.0.1:11434

# OpenAI-compatible (provider=openai): API key and MODEL are REQUIRED
# MINDTRACE_OPENAI_BASE_URL=https://api.groq.com/openai/v1   # or https://openrouter.ai/api/v1, https://api.openai.com/v1
# MINDTRACE_OPENAI_API_KEY=...
# json_object (widest support) | json_schema (stricter, if your model supports it) | none
# MINDTRACE_OPENAI_JSON_MODE=json_object

# Model IDs. Ollama defaults: qwen2.5:3b / qwen2.5:0.5b.
# Hosted: MODEL is required; JUDGE_MODEL defaults to MODEL.
# MINDTRACE_MODEL=
# MINDTRACE_JUDGE_MODEL=

MINDTRACE_TEMPERATURE=0.4
MINDTRACE_MAX_TOKENS=600
# MINDTRACE_SEED=42                 # set for reproducible runs
MINDTRACE_LLM_TIMEOUT_S=120
MINDTRACE_JUDGE_TIMEOUT_S=20

# Run without any model, using canned answers (UI / API development).
MINDTRACE_MOCK_LLM=false

# --- Guardrail ---
# When an analysis mentions a number not in the problem or reasoning:
#   judge (ask the judge model, fail-closed) | block | allow
MINDTRACE_NOVEL_NUMBER_POLICY=judge
# Send every analysis to the judge, not only ones with new numbers.
MINDTRACE_JUDGE_ALWAYS=false

# --- API ---
MINDTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MINDTRACE_MAX_INPUT_CHARS=4000
# Abuse / bill protection for /api/analyze (0 = off). Turn these on for public deployments.
MINDTRACE_RATE_LIMIT_PER_MINUTE=0
MINDTRACE_RATE_LIMIT_PER_HOUR=0
MINDTRACE_DAILY_REQUEST_CAP=0

# --- Frontend (build time, set in Vercel) ---
# Leave empty locally to use the dev proxy (/api -> :8000).
# VITE_API_URL=https://mindtrace-api.onrender.com
